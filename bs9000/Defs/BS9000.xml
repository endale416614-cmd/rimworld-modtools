<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef ParentName="ImplantHediffBase">
    <defName>BS9000</defName>
    <label>Bloodsucker 9000</label>
    <labelNoun>a Bloodsucker 9000</labelNoun>
    <description>This person has a Bloodsucker 9000 installed. It makes them irritated, uncomfortable and in mild pain. A horrible existence, serving as a blood bag.</description>
    <descriptionHyperlinks><ThingDef>Bloodsucker</ThingDef></descriptionHyperlinks>
    <spawnThingOnRemoved>Bloodsucker</spawnThingOnRemoved>
    <stages>
      <li>
        <painOffset>0.15</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.7</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li>
        <compClass>BS9000.HediffComp_BS9000</compClass>
      </li>
    </comps>
  </HediffDef>

  <ThingDef ParentName="BodyPartBionicBase">
    <defName>Bloodsucker</defName>
    <label>Bloodsucker 9000</label>
    <description>A peculiar implant originating from a forgotten Urbworld. Bloodsucker 9000 is a butt implant that works by allowing the subject to hemorrhage at a slow, controlled pace before eventually forcing them to discard an organic hemogen bag out of the intestinal tract, protected from acidic corrosion via mucus coagulation. Irritating, uncomfortable and pain-inflicting to the subject. As such, it is reserved for political prisoners and low-scoring employees on the most despotic of planets, and outright banned in Glitterworlds and developed societies due to its heinous nature.</description>
    <descriptionHyperlinks><RecipeDef>InstallBS9000</RecipeDef></descriptionHyperlinks>
    <costList>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <statBases>
      <Mass>0.5</Mass>
      <WorkToMake>8000</WorkToMake>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>BS9000</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <RecipeDef ParentName="SurgeryInstallImplantBase">
    <defName>InstallBS9000</defName>
    <label>install Bloodsucker 9000</label>
    <description>Install a Bloodsucker 9000.</description>
    <descriptionHyperlinks>
      <ThingDef>Bloodsucker</ThingDef>
      <HediffDef>BS9000</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing Bloodsucker 9000.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Bloodsucker</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Bloodsucker</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
    <addsHediff>BS9000</addsHediff>
  </RecipeDef>

  <RecipeDef ParentName="SurgeryRemoveImplantBase">
    <defName>RemoveBS9000</defName>
    <label>remove Bloodsucker 9000</label>
    <description>Remove the Bloodsucker 9000.</description>
    <descriptionHyperlinks>
      <ThingDef>Bloodsucker</ThingDef>
      <HediffDef>BS9000</HediffDef>
    </descriptionHyperlinks>
    <jobString>Removing Bloodsucker 9000.</jobString>
    <removesHediff>BS9000</removesHediff>
  </RecipeDef>

  <ResearchProjectDef>
    <defName>BS9000</defName>
    <label>Bloodsucker 9000</label>
    <description>Blueprints for the Bloodsucker 9000, a butt implant from a forgotten Urbworld that bleeds its host into one hemogen pack a day. Banned on every developed world. The host was not consulted.</description>
    <baseCost>1200</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>Bionics</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>17.0</researchViewX>
    <researchViewY>4.2</researchViewY>
  </ResearchProjectDef>

  <!-- Bite feedback: the sanguophage bite's sound, the hive spawn sound, Damage_HitFlesh's bullet-hit flecks turned up, and Bloodfeed_Warmup's drips. -->
  <EffecterDef>
    <defName>BS9000_Bite</defName>
    <positionRadius>0.1</positionRadius>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Bloodfeed_Cast</soundDef>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Hive_Spawn</soundDef>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.4</positionRadius>
        <fleckDef>AirPuff</fleckDef>
        <burstCount>6~8</burstCount>
        <speed>0.6~1.2</speed>
        <scale>1.2~1.5</scale>
        <color>(120, 18, 0)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.25</positionRadius>
        <fleckDef>BloodSplash</fleckDef>
        <burstCount>5~7</burstCount>
        <scale>1.4~1.8</scale>
        <color>(210, 50, 0)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.0</positionRadius>
        <fleckDef>BodyImpact</fleckDef>
        <burstCount>1</burstCount>
        <scale>0.6</scale>
        <color>(255, 120, 30, 60)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>BloodFeedSplash</fleckDef>
        <burstCount>5~8</burstCount>
        <positionRadius>0.2</positionRadius>
        <positionOffset>(0, 0, 0.5)</positionOffset>
        <color>(210, 50, 0)</color>
        <speed>-1.5</speed>
        <rotateTowardsTargetCenter>True</rotateTowardsTargetCenter>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <spawnLocType>RandomDrawPosOnTarget</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <!-- BS-7500 Drain Lance. Built on the vanilla psychic lances: an apparel with a
       targeted verb, no projectile, and CompApparelReloadable set to one charge so
       the lance destroys itself the moment it is fired. -->
  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>BS7500_DrainLance</defName>
    <label>BS-7500 drain lance</label>
    <description>A humanitarian compliance tool built by an Urbworld megacorp to pacify protestors without wasting the protestor. A large-bore needle and a pressure motor empty the subject into a sealed tank, where the contents are liquefied into hemogen packs for the riot police. The subject does not survive the process. Life is cheap on an Urbworld.\n\nThe lance is disposable and tears itself apart on the single use it was built for.</description>
    <descriptionHyperlinks>
      <ThingDef>HemogenPack</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/BS9000/DrainLance</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <tickerType>Normal</tickerType>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <statBases>
      <Mass>2.5</Mass>
      <EquipDelay>1</EquipDelay>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToMake>6000</WorkToMake>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
      <researchPrerequisite>BS9000</researchPrerequisite>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <useIngredientsForColor>false</useIngredientsForColor>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>320</displayPriority>
    </recipeMaker>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <ignoredByNonViolent>true</ignoredByNonViolent>
      <wearPerDay>0</wearPerDay>
      <!-- Waist, so the lance and the tank can be worn together. -->
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>BS9000_DrainLance</li>
      </tags>
      <wornGraphicPath>Things/Item/BS9000/DrainLance</wornGraphicPath>
    </apparel>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <tradeNeverStack>true</tradeNeverStack>
    <relicChance>0</relicChance>
    <drawGUIOverlay>false</drawGUIOverlay>
    <verbs>
      <li>
        <verbClass>Verb_CastTargetEffect</verbClass>
        <label>drain lance</label>
        <hasStandardCommand>true</hasStandardCommand>
        <targetable>true</targetable>
        <onlyManualCast>True</onlyManualCast>
        <!-- Short reach and a long aim, so this is a close-quarters commitment. -->
        <range>7.9</range>
        <warmupTime>3.5</warmupTime>
        <targetParams>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
        </targetParams>
        <soundCast>Bloodfeed_Cast</soundCast>
        <soundAiming>Interact_Drill</soundAiming>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_ApparelReloadable">
        <maxCharges>1</maxCharges>
        <destroyOnEmpty>true</destroyOnEmpty>
        <hotKey>Misc4</hotKey>
        <chargeNoun>charge</chargeNoun>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
      </li>
      <!-- Goodwill first: it reads the victim's faction, and the drain comp kills them. -->
      <li Class="CompProperties_TargetEffect_GoodwillImpact">
        <goodwillImpact>-200</goodwillImpact>
      </li>
      <li Class="BS9000.CompProperties_DrainLance">
        <packsPerBodySize>6</packsPerBodySize>
      </li>
    </comps>
  </ThingDef>

  <!-- BG-9555 Hemogen Tank. CompApparelReloadable with HemogenPack as its ammo gives
       the storage and the manual refill with no code; the mod only adds what pulls
       hemogen back out again. -->
  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>BG9555_HemogenTank</defName>
    <label>BG-9555 hemogen tank</label>
    <description>A pressurized liquid storage pack worn on the back, built to keep hemogen on the field instead of in a freezer. A sanguophage wearing one is topped up from the tank automatically, and medics draw on it to transfuse the wounded without a trip to the stockpile.\n\nThe tank has no intake of its own. It is refilled by hand, one hemogen pack at a time.</description>
    <descriptionHyperlinks>
      <ThingDef>HemogenPack</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/BS9000/HemogenTank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <tickerType>Normal</tickerType>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <statBases>
      <Mass>4</Mass>
      <EquipDelay>2</EquipDelay>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>9000</WorkToMake>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
      <researchPrerequisite>BS9000</researchPrerequisite>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <useIngredientsForColor>false</useIngredientsForColor>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>321</displayPriority>
    </recipeMaker>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <wearPerDay>0</wearPerDay>
      <!-- Torso on the Belt layer is the pack slot: it leaves Waist free for belts and
           for the drain lance. This is what Packs Are Not Belts does to the vanilla packs. -->
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>BS9000_HemogenTank</li>
      </tags>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/HemogenTank/HemogenTank</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <east>
          <offset>(-0.35,-0.05)</offset>
          <thin><offset>(0.05,0)</offset></thin>
          <hulk><offset>(-0.1,0)</offset></hulk>
          <fat><offset>(-0.15,0)</offset></fat>
        </east>
        <west>
          <offset>(0.35,-0.05)</offset>
          <thin><offset>(-0.05,0)</offset></thin>
          <hulk><offset>(0.1,0)</offset></hulk>
          <fat><offset>(0.15,0)</offset></fat>
        </west>
        <male>  <scale>(0.75,0.75)</scale></male>
        <female><scale>(0.75,0.75)</scale></female>
        <thin>  <scale>(0.7,0.7)</scale></thin>
        <hulk>  <scale>(0.9,0.9)</scale></hulk>
        <fat>   <scale>(0.9,0.9)</scale></fat>
      </wornGraphicData>
    </apparel>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <tradeNeverStack>true</tradeNeverStack>
    <relicChance>0</relicChance>
    <comps>
      <li Class="CompProperties_ApparelReloadable">
        <maxCharges>10</maxCharges>
        <ammoDef>HemogenPack</ammoDef>
        <ammoCountPerCharge>1</ammoCountPerCharge>
        <baseReloadTicks>120</baseReloadTicks>
        <soundReload>Standard_Reload</soundReload>
        <destroyOnEmpty>false</destroyOnEmpty>
        <hotKey>Misc4</hotKey>
        <chargeNoun>hemogen pack</chargeNoun>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
      </li>
      <li Class="BS9000.CompProperties_HemogenTank">
        <hemogenPerPack>0.2</hemogenPerPack>
        <bloodLossPerPack>0.25</bloodLossPerPack>
        <minBloodLossToTreat>0.25</minBloodLossToTreat>
      </li>
    </comps>
  </ThingDef>

  <JobDef>
    <defName>BS9000_TankTransfuse</defName>
    <driverClass>BS9000.JobDriver_TankTransfuse</driverClass>
    <reportString>transfusing hemogen into TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <WorkGiverDef>
    <defName>BS9000_TankTransfuse</defName>
    <label>transfuse hemogen from tank</label>
    <giverClass>BS9000.WorkGiver_TankTransfuse</giverClass>
    <workType>Doctor</workType>
    <verb>transfuse hemogen into</verb>
    <gerund>transfusing hemogen into</gerund>
    <!-- Just above the vanilla FeedHemogen giver at 65, so a worn tank is spent
         before a carrier walks to the stockpile for a loose pack. -->
    <priorityInType>66</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <ThoughtDef>
    <defName>BS9000_Hemorrhoids</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <nullifyingTraits>
      <li>Masochist</li>
    </nullifyingTraits>
    <stages>
      <li>
        <label>Hemorrhoids</label>
        <description>I am pooping out hemogen packs! What's happening to me?</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>BS9000_Masochist</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <requiredTraits>
      <li>Masochist</li>
    </requiredTraits>
    <stages>
      <li>
        <label>Hemorrhoids</label>
        <description>AHHHHHH! More! Use me more!</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
