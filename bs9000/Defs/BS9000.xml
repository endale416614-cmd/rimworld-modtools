<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef ParentName="ImplantHediffBase">
    <defName>BS9000</defName>
    <label>Bloodsucker 9000</label>
    <labelNoun>a Bloodsucker 9000</labelNoun>
    <description>This person has a Bloodsucker 9000 installed. It makes them irritated, uncomfortable and in mild pain. A horrible existence, serving as a blood bag.</description>
    <descriptionHyperlinks><ThingDef>Bloodsucker</ThingDef></descriptionHyperlinks>
    <spawnThingOnRemoved>Bloodsucker</spawnThingOnRemoved>
    <stages>
      <li>
        <painOffset>0.15</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.7</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li>
        <compClass>BS9000.HediffComp_BS9000</compClass>
      </li>
    </comps>
  </HediffDef>

  <ThingDef ParentName="BodyPartBionicBase">
    <defName>Bloodsucker</defName>
    <label>Bloodsucker 9000</label>
    <description>A peculiar implant originating from a forgotten Urbworld. Bloodsucker 9000 is a butt implant that works by allowing the subject to hemorrhage at a slow, controlled pace before eventually forcing them to discard an organic hemogen bag out of the intestinal tract, protected from acidic corrosion via mucus coagulation. Irritating, uncomfortable and pain-inflicting to the subject. As such, it is reserved for political prisoners and low-scoring employees on the most despotic of planets, and outright banned in Glitterworlds and developed societies due to its heinous nature.</description>
    <descriptionHyperlinks><RecipeDef>InstallBS9000</RecipeDef></descriptionHyperlinks>
    <costList>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <statBases>
      <Mass>0.5</Mass>
      <WorkToMake>8000</WorkToMake>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>BS9000</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <RecipeDef ParentName="SurgeryInstallImplantBase">
    <defName>InstallBS9000</defName>
    <label>install Bloodsucker 9000</label>
    <description>Install a Bloodsucker 9000.</description>
    <descriptionHyperlinks>
      <ThingDef>Bloodsucker</ThingDef>
      <HediffDef>BS9000</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing Bloodsucker 9000.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Bloodsucker</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Bloodsucker</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
    <addsHediff>BS9000</addsHediff>
  </RecipeDef>

  <RecipeDef ParentName="SurgeryRemoveImplantBase">
    <defName>RemoveBS9000</defName>
    <label>remove Bloodsucker 9000</label>
    <description>Remove the Bloodsucker 9000.</description>
    <descriptionHyperlinks>
      <ThingDef>Bloodsucker</ThingDef>
      <HediffDef>BS9000</HediffDef>
    </descriptionHyperlinks>
    <jobString>Removing Bloodsucker 9000.</jobString>
    <removesHediff>BS9000</removesHediff>
  </RecipeDef>

  <ResearchProjectDef>
    <defName>BS9000</defName>
    <label>Bloodsucker 9000</label>
    <description>Blueprints for the Bloodsucker 9000, a butt implant from a forgotten Urbworld that bleeds its host into one hemogen pack a day. Banned on every developed world. The host was not consulted.</description>
    <baseCost>1200</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>Bionics</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>17.0</researchViewX>
    <researchViewY>4.2</researchViewY>
  </ResearchProjectDef>

  <!-- Bite feedback: the sanguophage bite's sound, the hive spawn sound, Damage_HitFlesh's bullet-hit flecks turned up, and Bloodfeed_Warmup's drips. -->
  <EffecterDef>
    <defName>BS9000_Bite</defName>
    <positionRadius>0.1</positionRadius>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Bloodfeed_Cast</soundDef>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Hive_Spawn</soundDef>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.4</positionRadius>
        <fleckDef>AirPuff</fleckDef>
        <burstCount>6~8</burstCount>
        <speed>0.6~1.2</speed>
        <scale>1.2~1.5</scale>
        <color>(120, 18, 0)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.25</positionRadius>
        <fleckDef>BloodSplash</fleckDef>
        <burstCount>5~7</burstCount>
        <scale>1.4~1.8</scale>
        <color>(210, 50, 0)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.0</positionRadius>
        <fleckDef>BodyImpact</fleckDef>
        <burstCount>1</burstCount>
        <scale>0.6</scale>
        <color>(255, 120, 30, 60)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>BloodFeedSplash</fleckDef>
        <burstCount>5~8</burstCount>
        <positionRadius>0.2</positionRadius>
        <positionOffset>(0, 0, 0.5)</positionOffset>
        <color>(210, 50, 0)</color>
        <speed>-1.5</speed>
        <rotateTowardsTargetCenter>True</rotateTowardsTargetCenter>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <spawnLocType>RandomDrawPosOnTarget</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <ThoughtDef>
    <defName>BS9000_Hemorrhoids</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <nullifyingTraits>
      <li>Masochist</li>
    </nullifyingTraits>
    <stages>
      <li>
        <label>Hemorrhoids</label>
        <description>I am pooping out hemogen packs! What's happening to me?</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>BS9000_Masochist</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <requiredTraits>
      <li>Masochist</li>
    </requiredTraits>
    <stages>
      <li>
        <label>Hemorrhoids</label>
        <description>AHHHHHH! More! Use me more!</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
