<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- citadel-flame-sound: Fortification Industrial - Citadel's flame wall turret still names the VFE Security 1.5 sound
	     VFE_Shot_InfernoSpewer. VFE Security 1.6 dropped it; its flame turret now uses the vanilla InfernoCannon_Fire. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="FTC_Wall_Flame_Gun"]/verbs/li[soundCast="VFE_Shot_InfernoSpewer"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="FTC_Wall_Flame_Gun"]/verbs/li/soundCast[text()="VFE_Shot_InfernoSpewer"]</xpath>
			<value>
				<soundCast>InfernoCannon_Fire</soundCast>
			</value>
		</match>
	</Operation>

	<!-- betterarchitect-order: Better Architect sets the int field DesignationCategoryDef.order of the Gravship
	     categories to 0.1, which the game parses as 0 with a warning. Write the 0 it already uses. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/DesignationCategoryDef[order="0.1"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/DesignationCategoryDef/order[text()="0.1"]</xpath>
			<value>
				<order>0</order>
			</value>
		</match>
	</Operation>

	<!-- vge-explodeonfire: Vanilla Gravship Expanded 1.7 sets minFireToExplode to 0.35, but VEF declares it as an int
	     and compares fireSize >= (float)minFireToExplode, so it already loads as 0 (any fire). Write that 0. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/HediffDef/comps/li[@Class="VEF.AnimalBehaviours.HediffCompProperties_ExplodeOnFire"][minFireToExplode="0.35"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/HediffDef/comps/li[@Class="VEF.AnimalBehaviours.HediffCompProperties_ExplodeOnFire"]/minFireToExplode[text()="0.35"]</xpath>
			<value>
				<minFireToExplode>0</minFireToExplode>
			</value>
		</match>
	</Operation>

	<!-- ancienthatch-shotover: Buildable Ancient Stockpiles makes the flat, impassable AncientHatch player-buildable,
	     which trips the 1.7 check for impassable buildings that can be shot over. A floor hatch is meant to be. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="AncientHatch"][designationCategory][not(disableImpassableShotOverConfigError)]</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="AncientHatch"]</xpath>
			<value>
				<disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
			</value>
		</match>
	</Operation>
	<!-- comp-props-class: these comps read typed properties, so the plain class in the def throws InvalidCastException. A
	     bare CompReportWorkSpeed (Fortifications Medieval Material's gathering spot) throws whenever it is inspected; a
	     CompUseEffect_DestroySelf on plain CompProperties_UseEffect (More Archotech Garbage's cores) throws when used. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef/comps/li[not(@Class) and compClass="CompReportWorkSpeed"]</xpath>
		<match Class="PatchOperationAttributeSet">
			<xpath>Defs/ThingDef/comps/li[not(@Class) and compClass="CompReportWorkSpeed"]</xpath>
			<attribute>Class</attribute>
			<value>CompProperties_ReportWorkSpeed</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef/comps/li[@Class="CompProperties_UseEffect" and compClass="CompUseEffect_DestroySelf"]</xpath>
		<match Class="PatchOperationAttributeSet">
			<xpath>Defs/ThingDef/comps/li[@Class="CompProperties_UseEffect" and compClass="CompUseEffect_DestroySelf"]</xpath>
			<attribute>Class</attribute>
			<value>CompProperties_UseEffectDestroySelf</value>
		</match>
	</Operation>
	<!-- rebuild-glassdoor-graphic: ReBuild's glass autodoor adds an extra door graphic and a toggle for it, but the mod ships
	     no GlassAutodoor_VanillaMenuIcon texture, so selecting the door logs a load error. Drop the comp that needs it. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RB_GlassAutodoor"]/comps/li[toggleIcon="Things/Building/RB_Door/GlassAutodoor_VanillaMenuIcon"]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/ThingDef[defName="RB_GlassAutodoor"]/comps/li[toggleIcon="Things/Building/RB_Door/GlassAutodoor_VanillaMenuIcon"]</xpath>
		</match>
	</Operation>
	<!-- dungeon-decor-copies: Isekai Dungeons rejects decor that refunds materials, and Dismantle Ancient Junk gives these things
	     a cost list. Dungeons place the refund-free copies in Defs/LP17Decor.xml instead. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientCrate"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientCrate"]</xpath>
			<value>
				<thing>LP17_Decor_AncientCrate</thing>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientBarrel"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientBarrel"]</xpath>
			<value>
				<thing>LP17_Decor_AncientBarrel</thing>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientLamp"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientLamp"]</xpath>
			<value>
				<thing>LP17_Decor_AncientLamp</thing>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientEmergencyLight_Red"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientEmergencyLight_Red"]</xpath>
			<value>
				<thing>LP17_Decor_EmergencyLight_Red</thing>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientEmergencyLight_Green"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/IsekaiDungeons.DungeonDecorSetDef/entries/li/thing[text()="AncientEmergencyLight_Green"]</xpath>
			<value>
				<thing>LP17_Decor_EmergencyLight_Green</thing>
			</value>
		</match>
	</Operation>

	<!-- genecategory-priority-480: Fairycore's FG_Wings and Lichenkin - Ecology Overhaul's Lichenkin_Kith both
	     claim displayPriorityInXenotype 480, and the game logs a config error on each of them. Lichenkin loads after
	     this mod, so the free slot is given to the wings category. Nothing else in the list uses 475. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/GeneCategoryDef[defName="FG_Wings"][displayPriorityInXenotype="480"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/GeneCategoryDef[defName="FG_Wings"]/displayPriorityInXenotype</xpath>
			<value>
				<displayPriorityInXenotype>475</displayPriorityInXenotype>
			</value>
		</match>
	</Operation>

</Patch>
